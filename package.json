{
  "name": "kindkeys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A one-minute typing practice built around passages worth sitting with.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:passages": "node scripts/check-passages.mjs",
    "test:caret": "node scripts/check-caret.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.47.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
